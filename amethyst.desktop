[Desktop Entry]
Type=Application
Name=Amethyst
GenericName=Low-Level Development Environment
GenericName[ru]=Среда низкоуровневой разработки
Comment=Amethyst — Windows-focused IDE for low-level programming with hex editor, disassembler, and code editor
Comment[ru]=Amethyst — Среда для низкоуровневого программирования с hex-редактором, дизассемблером и редактором кода
Exec=amethyst %F
Icon=amethyst
Terminal=false
Categories=Development;IDE;
Keywords=hex;disassembler;reverse;engineering;amethyst;
MimeType=application/octet-stream;application/x-executable;application/x-sharedlib;application/x-object;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-asm;text/plain;
StartupNotify=true
StartupWMClass=amethyst
