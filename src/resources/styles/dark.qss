QWidget {
    background-color: #17141f;
    color: #ede9f6;
}

QHexView {
    background-color: #120f18;
    border: none;
}

QPushButton {
    background-color: #211a2d;
    border: 1px solid #3d2b54;
    border-radius: 4px;
    color: #ede9f6;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #381f5c;
    border: 1px solid #9d5ce5;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #4a247c;
    border: 2px solid #a855f7;
    font-weight: bold;
}

QPushButton:disabled {
    background-color: #1b1625;
    border: 1px solid #281d36;
    color: #635677;
}

QComboBox {
    background-color: #1c1527;
    border: 1px solid #3d2b54;
    border-radius: 4px;
    color: #ede9f6;
    padding: 4px 8px;
}

QComboBox:hover {
    background-color: #281a3e;
    border: 1px solid #9d5ce5;
}

QComboBox::drop-down {
    border: none;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #16111f;
    border: 1px solid #3d2b54;
    border-radius: 4px;
    color: #ede9f6;
    selection-background-color: #5b21b6;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #9d5ce5;
    background-color: #1c1527;
}

QSpinBox {
    background-color: #16111f;
    border: 1px solid #3d2b54;
    border-radius: 4px;
    color: #ede9f6;
    padding: 4px 8px;
}

QSpinBox:focus {
    border: 1px solid #9d5ce5;
}

QListView, QTreeView, QTableView {
    background-color: #13101a;
    border: 1px solid #281e36;
    alternate-background-color: #171320;
    color: #ede9f6;
}

QTreeView::item:selected {
    background-color: #3d1f65;
    color: #ffffff;
}

QTreeView::item:hover:!selected {
    background-color: #241a33;
}

QTabWidget::pane {
    border: 1px solid #2d1f42;
    background-color: #15111d;
}

/* Files Editor Tab Bar */
#filesTabWidget QTabBar::close-button {
    image: url(:/icons/close.svg);
}

#filesTabWidget QTabBar::close-button:hover {
    image: url(:/icons/close.svg);
}

#filesTabWidget QTabBar::tab {
    background: #1c1626;
    border: 1px solid #2d1f42;
    color: #a797be;
}

#filesTabWidget QTabBar::tab:selected {
    background: qlineargradient(
        x1:0, y1:1, x2:0, y2:0,
        stop:0 #140f1d,
        stop:0.92 #140f1d,
        stop:0.93 #9d5ce5,
        stop:1 #9d5ce5
    );
    color: #ffffff;
    font-weight: 500;
}

#filesTabWidget QTabBar::tab:hover:!selected {
    background-color: #261c36;
    color: #d8b4fe;
}

/* Tools Tab Bar (Output, Terminal, etc.) */
#toolTabWidget QTabBar::tab {
    padding: 5px;
    height: 20px;
    min-width: 100px;
    max-width: 200px;
    background: #1c1626;
    border: 1px solid #2d1f42;
    color: #a797be;
}

#toolTabWidget QTabBar::tab:selected {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #140f1d,
        stop:0.92 #140f1d,
        stop:0.93 #9d5ce5,
        stop:1 #9d5ce5
    );
    color: #ffffff;
    font-weight: bold;
}

#toolTabWidget QTabBar::tab:hover:!selected {
    background-color: #261c36;
}

/* Hex Editor View */
QListWidget#hexTabsList {
    background: #120f18;
    border: none;
}

QListWidget#hexTabsList::item {
    background: #1b1425;
    border-radius: 4px;
    color: #a797be;
}

QListWidget#hexTabsList::item:hover {
    background: #271a38;
    color: #ffffff;
}

QListWidget#hexTabsList::item:selected {
    background: qlineargradient(
        x1:1, y1:0, x2:0, y2:0,
        stop:0 #1b1425,
        stop:0.97 #1b1425,
        stop:0.98 #9d5ce5,
        stop:1 #9d5ce5
    );
    color: #ffffff;
}

#hexViewTab QWidget {
    background: #120f18;
}

/* Menu Bar & Menus */
QMenuBar {
    background-color: #140f1d;
    border-bottom: 1px solid #281d36;
}

QMenuBar::item {
    background: transparent;
    color: #d1c7e2;
}

QMenuBar::item:selected,
QMenuBar::item:hover {
    background-color: #2e1c47;
    color: #ffffff;
}

QMenu {
    background-color: #1a1325;
    border: 1px solid #3f285e;
}

QMenu::item {
    color: #ede9f6;
}

QMenu::item:selected {
    background-color: #4a247a;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #35224e;
    margin: 4px 6px;
}

QMenu::indicator {
    border-radius: 2px;
    border: 1px solid #4a2d6e;
}

QMenu::indicator:checked {
    background-color: #9d5ce5;
}

QMenu::indicator:unchecked {
    background-color: #171120;
}

/* Status buttons */
QPushButton[state="green"] {
    border: 1px solid #22c55e;
    color: #4ade80;
}
QPushButton::hover[state="green"] {
    background-color: #143520;
    border: 1px solid #4ade80;
}
QPushButton::pressed[state="green"] {
    background-color: #143520;
    border: 2px solid #4ade80;
    font-weight: bold;
}

QPushButton[state="red"] {
    border: 1px solid #ef4444;
    color: #f87171;
}
QPushButton::hover[state="red"] {
    background-color: #3b1419;
    border: 1px solid #f87171;
}
QPushButton::pressed[state="red"] {
    background-color: #3b1419;
    border: 2px solid #f87171;
    font-weight: bold;
}

/* Scrollbars */
QScrollBar:vertical {
    background: #130f1b;
    width: 12px;
}

QScrollBar::handle:vertical {
    background: #35214d;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #5b21b6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
    height: 0;
}

QScrollBar:horizontal {
    background: #130f1b;
    height: 12px;
}

QScrollBar::handle:horizontal {
    background: #35214d;
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: #5b21b6;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: none;
    width: 0;
}

/* Search Panel */
QWidget#searchPanel {
    background-color: #171221;
    border-left: 1px solid #332149;
}

QWidget#searchPanel QLineEdit,
QWidget#searchPanel QComboBox {
    background-color: #120e1a;
    color: #ede9f6;
    border: 1px solid #3a2653;
    border-radius: 4px;
}

QWidget#searchPanel QLineEdit:focus,
QWidget#searchPanel QComboBox:focus {
    border: 1px solid #9d5ce5;
}

QWidget#searchPanel QPushButton,
QWidget#searchPanel QToolButton {
    background-color: #231936;
    color: #ede9f6;
    border: 1px solid #3d275b;
    border-radius: 4px;
}

QWidget#searchPanel QPushButton:hover,
QWidget#searchPanel QToolButton:hover {
    background-color: #3b1d60;
    border: 1px solid #9d5ce5;
}

/* Settings Dialog Styling */
QDialog#settingsDialog {
    background-color: #14101c;
}

QDialog#settingsDialog QTabWidget#settingsTabWidget::pane {
    border: 1px solid #33214b;
    background-color: #181223;
    border-radius: 6px;
}

QDialog#settingsDialog QTabBar::tab {
    background-color: #1e152d;
    color: #a797be;
    border: 1px solid #2e1d44;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 18px;
    font-size: 12px;
    margin-right: 2px;
}

QDialog#settingsDialog QTabBar::tab:selected {
    background-color: #181223;
    color: #f3eefc;
    border-bottom: 2px solid #9d5ce5;
    font-weight: bold;
}

QDialog#settingsDialog QTabBar::tab:hover:!selected {
    background-color: #271a3b;
    color: #d8b4fe;
}

QDialog#settingsDialog QGroupBox {
    border: 1px solid #35224e;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 16px;
    color: #c4b5fd;
    font-weight: bold;
}

QDialog#settingsDialog QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
}

QDialog#settingsDialog QLabel#settingsStatusLabel[statusState="ok"] {
    color: #4ade80;
    font-weight: bold;
}

QDialog#settingsDialog QLabel#settingsStatusLabel[statusState="missing"] {
    color: #f87171;
    font-weight: bold;
}

QPushButton#SettingsApplyBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7c3aed, stop:1 #9333ea);
    color: #ffffff;
    border: none;
    border-radius: 5px;
    padding: 6px 18px;
    font-weight: bold;
}

QPushButton#SettingsApplyBtn:hover {
    background: #a855f7;
}

/* Disk Image Viewer */
#DiskImagePage QTableWidget,
QDialog#DiskImageViewerDialog QTableWidget {
    background-color: #130f1c;
    border: 1px solid #2e1d44;
    gridline-color: #231636;
    border-radius: 4px;
}

#DiskImagePage QTableWidget::item:selected,
QDialog#DiskImageViewerDialog QTableWidget::item:selected {
    background-color: #442270;
    color: #ffffff;
}

#DiskImagePage QTableWidget::item:hover,
QDialog#DiskImageViewerDialog QTableWidget::item:hover {
    background-color: #251838;
}

#DiskImagePage QGroupBox,
QDialog#DiskImageViewerDialog QGroupBox {
    border: 1px solid #362250;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 14px;
    color: #c4b5fd;
    font-weight: bold;
}

/* ==========================================
 * Status Bar
 * ========================================== */
QStatusBar,
QStatusBar#ideStatusBar {
    background-color: #120e1a;
    border-top: 1px solid #291a3c;
    color: #a797be;
    min-height: 24px;
}

QStatusBar::item {
    border: none;
    padding: 2px 8px;
}

QLabel#ideStatusLabel {
    color: #c084fc;
    font-size: 11px;
    font-weight: 500;
    padding: 2px 10px;
    background: #1e132e;
    border: 1px solid #3b205a;
    border-radius: 4px;
    margin-right: 6px;
}

/* ==========================================
 * Splitters
 * ========================================== */
QSplitter::handle {
    background-color: #1d152a;
}

QSplitter::handle:hover {
    background-color: #7c3aed;
}

QSplitter::handle:pressed {
    background-color: #a855f7;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QSplitter::handle:vertical {
    height: 3px;
}

/* ==========================================
 * ToolTips
 * ========================================== */
QToolTip {
    background-color: #1f1430;
    color: #f3eefc;
    border: 1px solid #6b21a8;
    border-radius: 5px;
    padding: 5px 8px;
    font-size: 11px;
}

/* ==========================================
 * Checkboxes & Radio Buttons
 * ========================================== */
QCheckBox, QRadioButton {
    color: #ede9f6;
    spacing: 7px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
    background-color: #161122;
    border: 1px solid #3d2b56;
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #9d5ce5;
    background-color: #241838;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #7c3aed;
    border-color: #a855f7;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: #151020;
    border-color: #271a36;
}

/* ==========================================
 * Progress Bars
 * ========================================== */
QProgressBar {
    background-color: #150f21;
    border: 1px solid #311e47;
    border-radius: 4px;
    text-align: center;
    color: #f3eefc;
    font-size: 11px;
    font-weight: bold;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7c3aed, stop:1 #a855f7);
    border-radius: 3px;
}

/* ==========================================
 * Table & Tree Headers
 * ========================================== */
QHeaderView::section {
    background-color: #181125;
    color: #c4b5fd;
    border: none;
    border-right: 1px solid #281a3a;
    border-bottom: 1px solid #281a3a;
    padding: 5px 8px;
    font-weight: 600;
    font-size: 11px;
}

QHeaderView::section:hover {
    background-color: #241638;
    color: #ffffff;
}

/* ==========================================
 * Terminal Widget Display
 * ========================================== */
QPlainTextEdit#terminalDisplay {
    background-color: #120e1a;
    color: #ede9f6;
    border: none;
    font-family: 'JetBrains Mono', 'Consolas', monospace;
    font-size: 10pt;
    selection-background-color: #6b21a8;
    selection-color: #ffffff;
}

/* ==========================================
 * Dialogs (QMessageBox, FileDialog, etc.)
 * ========================================== */
QMessageBox {
    background-color: #171222;
}

QMessageBox QLabel {
    color: #ede9f6;
    font-size: 12px;
}

QMessageBox QPushButton {
    min-width: 75px;
}


