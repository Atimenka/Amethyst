
QWidget {
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Inter", "Roboto", "Helvetica Neue", sans-serif;
    font-size: 12px;
}

QHexView {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 14px;
}

QPushButton {
    padding: 6px 14px;
}

QComboBox {
    padding: 4px 8px;
}

QComboBox::drop-down {
    border: 0px;
    width: 0px;
}

QComboBox::down-arrow {
    image: none;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    padding: 4px 6px;
}

#filesTabWidget QTabBar::close-button {
    subcontrol-position: right;
    padding: 2px;
}

#filesTabWidget QTabBar::close-button:hover {
    padding: 1px;
}

#filesTabWidget QTabBar::tab {
    padding: 6px 14px;
    height: 18px;
    min-width: 100px;
    max-width: 240px;
}

#toolTabWidget QTabBar::tab {
    padding: 5px 12px;
    height: 20px;
    min-width: 90px;
    max-width: 200px;
}

#toolTabWidget QTabBar::tab:selected {
    height: 20px;
}

QListWidget#hexTabsList {
    min-width: 120px;
    max-width: 200px;
    font-size: 12px;
    padding-top: 5px;
    padding-bottom: 5px;
}

QListWidget#hexTabsList::item {
    padding: 6px;
    margin: 4px;
    outline: none;
}

QListWidget#hexTabsList::item:selected {
    outline: none;
}

QListWidget#hexTabsList::item:focus {
    outline: none;
}

QTreeView {

}

QMenu::item {
    padding: 5px 22px 5px 8px;
}

QMenu::indicator {
    width: 12px;
    height: 12px;
    margin-left: 5px;
    margin-right: 5px;
}

/* Vertical QScrollBar */

QScrollBar:vertical {
    width: 10px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Horizontal QScrollBar */

QScrollBar:horizontal {
    height: 10px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QWidget#searchPanel QLineEdit {
    padding: 5px 7px;
    min-height: 18px;
}

QWidget#searchPanel QPushButton {
    padding: 5px 10px;
    min-height: 18px;
}

QWidget#searchPanel QComboBox {
    padding: 5px 24px 5px 7px;
    min-height: 18px;
}

QWidget#searchPanel QComboBox::drop-down {
    width: 20px;
}

QWidget#searchPanel QComboBox::down-arrow {
    image: url(:/icons/welcome-caret-down.svg);
    width: 10px;
    height: 10px;
}

QWidget#searchPanel QToolButton {
    padding: 4px;
}

QWidget#searchPanel QLabel#searchEmptyTitle {
    font-weight: bold;
    font-size: 13px;
}

QWidget#searchPanel QLabel#searchStatusLabel {
    font-size: 11px;
}

QDialog#settingsDialog QLabel#settingsHintLabel {
    font-size: 11px;
}
